              <stringProp name="parameters"></stringProp>
              <stringProp name="script">// Get current time in seconds
long currentTimeInSeconds = System.currentTimeMillis() / 1000;

// Token lasts 600s, but we use a 590s buffer to prevent edge-case expiration mid-flight
long expiryTime = currentTimeInSeconds + 300; 

// Save the expiry timestamp to a variable
vars.put(&apos;C_Token_Expiry&apos;, String.valueOf(expiryTime));

</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
