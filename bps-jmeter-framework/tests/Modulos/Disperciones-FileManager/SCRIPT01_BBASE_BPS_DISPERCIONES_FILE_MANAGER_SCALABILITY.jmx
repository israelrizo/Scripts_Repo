            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonOutput
import java.time.LocalDateTime
import java.time.format.DateTimeFormatter
import java.util.Random

def rand = new Random()

// 1. Calcular y guardar la fecha programada (Mañana a las 09:00 AM)
LocalDateTime futureDateTime = LocalDateTime.now()
    .plusDays(1)
    .withHour(9)
    .withMinute(0)
    .withSecond(0)
    .withNano(0)

String combinedDateTime = futureDateTime.format(DateTimeFormatter.ofPattern(&quot;yyyy-MM-dd HH:mm&quot;))
vars.put(&quot;P_Scheduled_Date&quot;, combinedDateTime)


// 2. Extraer el operationConcept de forma segura como Texto Puro (Evita el error de parseo)
String rawBody = sampler.getArguments().getArgument(0).getValue()
String fileName = &quot;&quot;
long timestamp = System.currentTimeMillis()

if (rawBody) {
    // Buscamos directamente la línea de &quot;operationConcept&quot; usando expresiones regulares en el texto plano
    def matcher = rawBody =~ /&quot;operationConcept&quot;\s*:\s*&quot;([^&quot;]+)&quot;/
    if (matcher.find()) {
        String operationConcept = matcher[0][1] // Extrae el texto dentro de las comillas
        String conceptLower = operationConcept.toLowerCase()
        
        // 3. Verificación de palabras clave del concepto
        if (conceptLower.contains(&quot;spid&quot;)) {
            fileName = &quot;spid_&quot; + timestamp
        } else if (conceptLower.contains(&quot;spei&quot;)) {
            fileName = &quot;spei_&quot; + timestamp
        } else if (conceptLower.contains(&quot;traspasos&quot;)) {
            fileName = &quot;traspaso_&quot; + timestamp
        } else if (conceptLower.contains(&quot;swift&quot;)) {
            fileName = &quot;swift_&quot; + timestamp
        } else if (conceptLower.contains(&quot;mixto&quot;)) {
            fileName = &quot;mixto_&quot; + timestamp
        }
    }
}

// Si no encontró coincidencia o el body está vacío, asignamos uno por defecto para que no viaje nulo
if (fileName.isEmpty()) {
    fileName = &quot;batch_&quot; + timestamp
}
vars.put(&quot;P_File_Name&quot;, fileName)


// 4. Moldes de transacciones base
def txSPEI = [
    &quot;sourceId&quot;: &quot;33&quot;, &quot;clientId&quot;: &quot;391400&quot;, &quot;transactionType&quot;: &quot;SPEI&quot;, &quot;payerAccountNumber&quot;: &quot;145580039140001027&quot;,
    &quot;payerCurrencyCode&quot;: &quot;MXP&quot;, &quot;recipientAccountNumber&quot;: &quot;012580015083610648&quot;, &quot;recipientBankId&quot;: &quot;40012&quot;,
    &quot;recipientBankName&quot;: &quot;BBVA BANCOMER&quot;, &quot;recipientName&quot;: &quot;JAIME YADIR PARAS CERECERO&quot;,
    &quot;recipientRfc&quot;: &quot;PACJ8601043V6&quot;, &quot;recipientPersonType&quot;: &quot;Fisica&quot;, &quot;recipientEmail&quot;: &quot;&quot;,
    &quot;recipientAddress&quot;: &quot;&quot;, &quot;recipientCountry&quot;: &quot;&quot;, &quot;amount&quot;: 1.0,
    &quot;paymentConcept&quot;: &quot;Test SPEI desde Postman&quot;, &quot;additionalInfo&quot;: &quot;Adicional info&quot;, &quot;numericReference&quot;: &quot;1234567&quot;
]

/*def txSPID = [
    &quot;sourceId&quot;: &quot;33&quot;, &quot;ipAddress&quot;: &quot;127.0.0.1&quot;, &quot;clientId&quot;: &quot;391400&quot;, &quot;transactionType&quot;: &quot;SPID&quot;,
    &quot;payerAccountNumber&quot;: &quot;145580026&quot;, &quot;payerCurrencyCode&quot;: &quot;USD&quot;, &quot;recipientAccountNumber&quot;: &quot;021180070005672634&quot;,
    &quot;recipientBankId&quot;: &quot;40021&quot;, &quot;recipientBankName&quot;: &quot;HSBC&quot;, &quot;recipientName&quot;: &quot;Datavision Digital Sa De Cv&quot;,
    &quot;recipientRfc&quot;: &quot;DDI951027KV4&quot;, &quot;recipientPersonType&quot;: &quot;Moral&quot;, &quot;recipientEmail&quot;: &quot;&quot;,
    &quot;recipientAddress&quot;: &quot;&quot;, &quot;recipientCountry&quot;: &quot;&quot;, &quot;amount&quot;: 1.0,
    &quot;paymentConcept&quot;: &quot;Pruaba SPID desde Postman&quot;, &quot;additionalInfo&quot;: &quot;&quot;, &quot;numericReference&quot;: &quot;3400072&quot;
] */

def txOwn = [
    &quot;sourceId&quot;: &quot;33&quot;, &quot;clientId&quot;: &quot;391400&quot;, &quot;transactionType&quot;: &quot;TRANSFER_OWN_ACCOUNTS&quot;,
    &quot;payerAccountNumber&quot;: &quot;145580039140001027&quot;, &quot;payerCurrencyCode&quot;: &quot;MXP&quot;, &quot;recipientClientId&quot;: &quot;391400&quot;,
    &quot;recipientAccountNumber&quot;: &quot;145580039140001988&quot;, &quot;recipientName&quot;: &quot;SANDRA MARGARITA&quot;, &quot;recipientRfc&quot;: &quot;&quot;,
    &quot;recipientPersonType&quot;: &quot;&quot;, &quot;recipientEmail&quot;: &quot;&quot;, &quot;recipientAddress&quot;: &quot;&quot;,
    &quot;recipientCountry&quot;: &quot;&quot;, &quot;amount&quot;: 1.0, &quot;paymentConcept&quot;: &quot;Transferencia entre cuentas propias&quot;,
    &quot;additionalInfo&quot;: &quot;Transferencia entre cuentas propias&quot;, &quot;numericReference&quot;: &quot;1000001&quot;
]

def baseTransactions = [txSPEI, txOwn]
def dynamicTxList = []

// 100 bloques de 2 transacciones cada uno = 200 transacciones simétricas
int bloques = 100

for (int i = 0; i &lt; bloques; i++) {
    baseTransactions.each { baseTx -&gt;
        def newTx = new HashMap(baseTx)
        newTx.numericReference = String.valueOf(rand.nextInt(9000000) + 1000000)
        newTx.paymentConcept = baseTx.paymentConcept + &quot; L200-&quot; + (i + 1)
        dynamicTxList.add(newTx)
    }
}

// 5. Convertir la lista a formato plano JSON y pasarla a JMeter
def finalString = dynamicTxList.collect { JsonOutput.toJson(it) }.join(&quot;,&quot;)
vars.put(&quot;dynamicTransactions&quot;, finalString)</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
