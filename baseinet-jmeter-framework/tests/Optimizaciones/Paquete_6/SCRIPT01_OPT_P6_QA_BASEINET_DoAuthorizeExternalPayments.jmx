                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import java.security.MessageDigest;
import java.util.Base64;

if (sampler instanceof org.apache.jmeter.protocol.http.sampler.HTTPSamplerBase) {
    String apiUrl = sampler.getUrl().toString();
    String navigationData = vars.get(&quot;P_Navegations&quot;);

    if (navigationData != null) {
        String rawData = apiUrl + navigationData;
        MessageDigest digest = MessageDigest.getInstance(&quot;SHA-256&quot;);
        byte[] hash = digest.digest(rawData.getBytes(&quot;UTF-8&quot;));
        String requestId = Base64.getUrlEncoder().withoutPadding().encodeToString(hash);
        vars.put(&quot;P_Request_ID&quot;, requestId);
    }
} else {
    // Quietly ignore Flow Control Actions / Think Times without throwing an error
    log.info(&quot;Skipping global Request ID: &apos;&quot; + sampler.getName() + &quot;&apos; is not an HTTP Sampler.&quot;);
}</stringProp>
