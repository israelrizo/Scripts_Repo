   &lt;soapenv:Header/&gt;&#xd;
   &lt;soapenv:Body&gt;&#xd;
      &lt;tem:GetCuentas&gt;&#xd;
         &lt;tem:session&gt;${C_IdSesion}&lt;/tem:session&gt;&#xd;
         &lt;tem:idDivisa&gt;&lt;/tem:idDivisa&gt;&#xd;
      &lt;/tem:GetCuentas&gt;&#xd;
   &lt;/soapenv:Body&gt;&#xd;
&lt;/soapenv:Envelope&gt;</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
