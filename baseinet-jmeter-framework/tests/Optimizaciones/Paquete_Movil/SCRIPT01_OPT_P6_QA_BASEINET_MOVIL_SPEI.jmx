          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">// 1. Obtener tiempo de inicio registrado por el PreProcessor
def startTimeObj = vars.getObject(&quot;iterationStartTime&quot;)

if (startTimeObj != null) {
    long startTime = startTimeObj as Long
    long elapsedTime = System.currentTimeMillis() - startTime

    // 2. Definir la ventana objetivo: 6 minutos (360,000 ms)
    long targetCycleMs = 360000 

    // 3. Calcular el tiempo restante de pausa
    long pauseTime = targetCycleMs - elapsedTime

    if (pauseTime &gt; 0) {
        long endTime = System.currentTimeMillis() + pauseTime
        
        // Bloque de espera seguro en fragmentos de 1 segundo
        while (System.currentTimeMillis() &lt; endTime) {
            try {
                Thread.sleep(1000)
            } catch (InterruptedException e) {
                // Si JMeter se detiene, interrumpe el sleep y sale del bucle al instante
                break
            }
        }
    }
}

// Opcional: Descartar este sampler para no registrar la pausa como transacción en Grafana/JTL
SampleResult.setIgnore()</stringProp>
