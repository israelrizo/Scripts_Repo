            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="false">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import java.io.File
import java.io.FileWriter
import java.io.BufferedWriter

// 1. Obtener los valores almacenados en las variables de JMeter
String pUsername = vars.get(&quot;P_Username&quot;) ?: &quot;&quot;
String cCuenta = vars.get(&quot;C_Cuenta&quot;) ?: &quot;&quot;

// 2. Determinar si fue autorizada según el código de respuesta HTTP
String responseCode = prev.getResponseCode()
boolean esAutorizada = (responseCode == &quot;200&quot;)

// 3. Definir las rutas para ambos archivos
String basePath = &quot;C:/Users/fcabello/Documents/jmeter-framework/baseinet-jmeter-framework/data/&quot;
String filePath = esAutorizada ? 
    &quot;${basePath}resultado_transfer_Autorizadas_TEST.csv&quot; : 
    &quot;${basePath}resultado_transfer_NoAutorizadas_TEST.csv&quot;

File csvFile = new File(filePath)

// 4. Escribir datos (seguro para ejecución multihilo)
synchronized(this.class) {
    try {
        boolean fileExists = csvFile.exists() &amp;&amp; csvFile.length() &gt; 0
        
        FileWriter fw = new FileWriter(csvFile, true)
        BufferedWriter bw = new BufferedWriter(fw)
        
        // Escribe la cabecera solo si el archivo es nuevo o está vacío
        if (!fileExists) {
            bw.write(&quot;P_Username,C_Cuenta,ResponseCode&quot;)
            bw.newLine()
        }
        
        // Escribe el registro en el archivo correspondiente
        bw.write(&quot;${pUsername},${cCuenta},${responseCode}&quot;)
        bw.newLine()
        
        // Limpiar y cerrar flujos
        bw.flush()
        bw.close()
        fw.close()
    } catch (Exception e) {
        log.error(&quot;Error al escribir el archivo CSV: &quot; + e.getMessage())
    }
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
