              <stringProp name="XPathExtractor2.xpathQuery">//*[local-name()=&apos;Destinatario&apos;][*[local-name()=&apos;Cuenta&apos;]=&apos;145180006272001014&apos;]/*[local-name()=&apos;IdDestinatario&apos;]/text()</stringProp>
