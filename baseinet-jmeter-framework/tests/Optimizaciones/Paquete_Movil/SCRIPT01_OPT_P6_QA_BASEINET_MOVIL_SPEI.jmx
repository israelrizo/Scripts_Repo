            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="C_Cuenta" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.xml.XmlSlurper

// 1. Get the response data
def responseString = prev.getResponseDataAsString()

try {
    // 2. Parse the XML 
    def xml = new XmlSlurper().parseText(responseString)
    
    // 3. Search the entire XML tree (&apos;**&apos;) for the Cuenta node holding MXP
    def targetCuenta = xml.&apos;**&apos;.find { node -&gt;
        node.name() == &apos;Cuenta&apos; &amp;&amp; node.IdDivisa.text() == &apos;MXP&apos;
    }
    
    // 4. If the node is found, extract and validate the 18-digit IdCuenta
    if (targetCuenta != null) {
        def idCuenta = targetCuenta.IdCuenta.text()
        
        if (idCuenta.matches(&quot;\\d{18}&quot;)) {
            log.info(&quot;Successfully extracted MXP IdCuenta: &quot; + idCuenta)
            vars.put(&quot;C_Cuenta&quot;, idCuenta) // Saves to a JMeter variable
        } else {
            log.warn(&quot;Found MXP account, but IdCuenta is not 18 digits: &quot; + idCuenta)
        }
    } else {
        log.warn(&quot;Could not find a Cuenta node with IdDivisa = MXP.&quot;)
    }
    
} catch (Exception e) {
    log.error(&quot;Failed to parse the XML response: &quot; + e.getMessage())
}</stringProp>
            </JSR223PostProcessor>
