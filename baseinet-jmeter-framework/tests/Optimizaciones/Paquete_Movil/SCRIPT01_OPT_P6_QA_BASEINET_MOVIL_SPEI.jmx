            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="false">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// 1. Obtener las variables del hilo
def usuario = vars.get(&quot;P_Username&quot;) ?: &quot;DESCONOCIDO&quot;
def idDestino = vars.get(&quot;C_ID_Dest_Pablo&quot;) ? vars.get(&quot;C_ID_Dest_Pablo&quot;).trim() : &quot;&quot;

// 2. Definir los dos archivos de salida
def archivoExitosos = new File(&quot;C:/Users/fcabello/Documents/jmeter-framework/baseinet-jmeter-framework/data/resultados_pablo.csv&quot;)
def archivoNotFound = new File(&quot;C:/Users/fcabello/Documents/jmeter-framework/baseinet-jmeter-framework/data/resultados_not_found.csv&quot;)

// Función auxiliar para inicializar archivo con encabezado si no existe
def escribirRegistro = { File archivo, String fila -&gt;
    synchronized(archivo) {
        if (!archivo.exists()) {
            archivo.withWriterAppend(&apos;UTF-8&apos;) { out -&gt;
                out.writeLine(&quot;P_Username,C_ID_Dest_Pablo&quot;)
            }
        }
        archivo.withWriterAppend(&apos;UTF-8&apos;) { out -&gt;
            out.writeLine(fila)
        }
    }
}

// 3. Evaluar y clasificar el resultado
if (idDestino == &quot;NOT_FOUND&quot; || idDestino.isEmpty() || idDestino == &quot;C_ID_Dest_Pablo_MATCH_FAILED&quot;) {
    // Escribir en el archivo de no encontrados
    escribirRegistro(archivoNotFound, &quot;${usuario},${idDestino ?: &apos;NOT_FOUND&apos;}&quot;)
    log.warn(&quot;Destinatario NO encontrado para el usuario: ${usuario}&quot;)
} else {
    // Escribir en el archivo de éxitos
    escribirRegistro(archivoExitosos, &quot;${usuario},${idDestino}&quot;)
