                <collectionProp name="Arguments.arguments">
                  <elementProp name="P_Navegations" elementType="Argument">
                    <stringProp name="Argument.name">P_Navegations</stringProp>
                    <stringProp name="Argument.value">[&quot;G000000_V01_footer_S000&quot;, &quot;G000000_V01_header_S000&quot;, &quot;G000000_V01_contents1_S000&quot;, &quot;G000000_V01_contents1_S005&quot;, &quot;P01S005_TOKEN_VENCIDO&quot;]</stringProp>
