            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="false">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// 1. Get the total count of variables (assuming you have a variable named &apos;id_matchNr&apos;)
// If you don&apos;t have a matchNr, you can manually set the loop limit
def countStr = vars.get(&quot;C_Destinatario_Aliases_matchNr&quot;)
def alias = vars.get(&quot;C_Alias&quot;)
def rowid = vars.get(&quot;C_RowID&quot;)
def ctaDest = vars.get(&quot;C_CtaDestinatario&quot;)
//def alias = vars.get(&quot;P_EliminaAliasManual&quot;)

int count = countStr ? countStr.toInteger() : 0

log.info(&quot;Starting loop. Total items found: &quot; + count)
// 2. Iterate through the parameters
for (int i = 1; i &lt;= count; i++) {
    
    // Construct the variable name dynamically (e.g., id_1, id_2...)
    String currentVarName = &quot;C_DestRow_ID_&quot; + i
    
    // Get the value of that variable
    String currentValue = vars.get(currentVarName)
    // 3. Perform your check or logic here
    if (currentValue == rowid &amp;&amp; ) {
        log.warn(&quot;FOUND MATCH at index &quot; + i + &quot;: &quot; + currentValue)
        
        def resultado = vars.get(&quot;C_Destinatario_ID_&quot;+i)
        // Optional: Save the index or break the loop
        vars.put(&quot;C_DestinatarioID&quot;, resultado.toString())
	   break 
    } else {
        log.info(&quot;Checking index &quot; + i + &quot;: &quot; + currentValue + &quot; - Not a match&quot;)
    }
}</stringProp>
            </JSR223PreProcessor>
