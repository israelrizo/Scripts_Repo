            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.time.ZonedDateTime
import java.time.ZoneId
import java.time.format.DateTimeFormatter

// Explicitly define the Central Time Zone
def zone = ZoneId.of(&quot;America/Chicago&quot;)
def cstDate = ZonedDateTime.now(zone).plusDays(1).format(DateTimeFormatter.ofPattern(&quot;dd/mm/yyyy&quot;))

// Store it in a variable named &apos;dynamicDate&apos;
vars.put(&quot;P_Date&quot;, cstDate)</stringProp>
