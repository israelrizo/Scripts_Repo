        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor - DATETIME FORMAT" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
