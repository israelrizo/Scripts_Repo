          <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="SCRIPT00_BASEINET_QA_OPT_P4_INICIO_SESION_T03_Autenticar_ScGetAllAdsGrouped_ScIsAuthorized" enabled="true">
