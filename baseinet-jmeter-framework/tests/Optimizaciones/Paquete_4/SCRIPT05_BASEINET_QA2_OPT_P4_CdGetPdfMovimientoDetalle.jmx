              <stringProp name="Argument.value">[&quot;G000000_V01_footer_S000&quot;, &quot;G000000_V01_header_S000&quot;, &quot;G000000_V01_contents1_S000&quot;]</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
            </elementProp>
            <elementProp name="P_FromAccount" elementType="Argument">
              <stringProp name="Argument.name">P_FromAccount</stringProp>
              <stringProp name="Argument.value">145580030230001017</stringProp>
