        <hashTree/>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor - P_Request_IDV2" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.security.MessageDigest;
import java.util.Base64;
import groovy.json.JsonSlurper;

// 1. FILTRO DE ÁMBITO: Asegura que el script solo se ejecute si el sampler actual es una petición HTTP.
// Esto evita que falle cuando JMeter pasa por elementos de control como &quot;Think Time&quot; o &quot;Test Action&quot;.
if (sampler instanceof org.apache.jmeter.protocol.http.sampler.HTTPSamplerBase) {
    
    // Obtiene la URL completa del endpoint actual 
    String apiUrl = sampler.getUrl().toString();
    
    // 2. VALIDACIÓN DE ARGUMENTOS: Verifica que la petición tenga un cuerpo (payload) y que el primer argumento no sea nulo.
    if (sampler.getArguments() != null &amp;&amp; sampler.getArguments().getArgumentCount() &gt; 0) {
        def argumentObject = sampler.getArguments().getArgument(0);
        
        if (argumentObject != null) {
            try {
                // Extrae el texto plano del cuerpo de la petición POST
                String samplerRaw = argumentObject.getValue();
                
                // 3. FILTRO DE FORMATO: Valida que el cuerpo de la petición tenga texto y empiece como un objeto JSON (&quot;{&quot;)
                if (samplerRaw &amp;&amp; samplerRaw.trim().startsWith(&quot;{&quot;)) {
                    
                    // Transforma el texto plano del payload en un objeto JSON manipulable en Groovy
                    def json = new JsonSlurper().parseText(samplerRaw); 
                    
                    // Extrae de forma segura (?.) el arreglo o propiedad &quot;navegations&quot; del JSON
                    def navigationData = json?.navegations;
                    
                    // 4. GENERACIÓN DEL PAYLOAD CRIPTOGRÁFICO: Si la petición contiene datos de navegación, calcula la firma
                    if (navigationData) {
                        
                        // Concatena la URL del servicio actual con la cadena de texto de las navegaciones realizadas
                        String rawData = apiUrl + navigationData.toString();
                        
                        // Inicializa el algoritmo criptográfico SHA-256
                        MessageDigest digest = MessageDigest.getInstance(&quot;SHA-256&quot;);
                        
                        // Calcula el hash binario (array de bytes) a partir de la cadena concatenada en UTF-8
                        byte[] hash = digest.digest(rawData.getBytes(&quot;UTF-8&quot;));
                        
                        // Codifica el hash resultante en formato Base64 de tipo URL-Safe (reemplaza &apos;+&apos; por &apos;-&apos; y &apos;/&apos; por &apos;_&apos;)
                        // y elimina el relleno de caracteres al final (.withoutPadding())
                        String requestId = Base64.getUrlEncoder().withoutPadding().encodeToString(hash);
                        
                        // 5. PERSISTENCIA: Guarda el identificador generado en la variable global &apos;${P_Request_IDV2}&apos;
                        // para que el HTTP Sampler actual lo inyecte de manera dinámica en su cuerpo JSON
                        vars.put(&quot;P_Request_IDV2&quot;, requestId);
                    }
                }
            } catch (Exception e) {
                // MANEJO DE EXCEPCIONES: Si ocurre un error inesperado al parsear el JSON, se captura de manera silenciosa
                // en modo Debug para no inundar la consola ni saturar el disco con Stack Traces de Java.
                log.debug(&quot;No se pudo procesar el Request ID V2 para: &quot; + sampler.getName());
            }
        }
    }
}</stringProp>
