# /etc/systemd/system/jmeter-server.service  (on EACH SLAVE)
# - Uses the jmeter-server found on the user's login PATH (JMeter home configured on the server).
# - Fixed RMI ports so the Security Group can stay small.
# - Replace 10.0.1.11 with this slave's private IP and jmeter with the user that owns the scripts.
[Unit]
Description=JMeter remote engine (slave)
After=network-online.target remote-fs.target
RequiresMountsFor=/mnt/jmeter

[Service]
User=jmeter
WorkingDirectory=/mnt/jmeter/JMeter_Scripts/jmeter-framework
Environment=JVM_ARGS=-Xms1g -Xmx4g
Environment=RMI_HOST_DEF=-Djava.rmi.server.hostname=10.0.1.11
ExecStart=/bin/bash -lc 'exec jmeter-server -Dserver_port=1099 -Jserver.rmi.localport=50000 -Jserver.rmi.ssl.disable=true'
Restart=always
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
