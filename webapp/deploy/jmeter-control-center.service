# Template: install_master.sh replaces @WEBAPP_DIR@ / @SERVICE_USER@ and copies it to
# /etc/systemd/system/jmeter-control-center.service  (on the MASTER)
[Unit]
Description=JMeter Control Center (Scripts_Repo web UI)
After=network-online.target remote-fs.target
RequiresMountsFor=@WEBAPP_DIR@

[Service]
User=@SERVICE_USER@
WorkingDirectory=@WEBAPP_DIR@
EnvironmentFile=/etc/jmeter-control-center.env
ExecStart=@WEBAPP_DIR@/.venv/bin/python run.py
Restart=on-failure
# JMeter runs are children of this service: let them finish their own shutdown
KillMode=process
LimitNOFILE=65536
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
