# Copy to /etc/jmeter-control-center.env (chmod 600) and adjust. Read by the systemd unit.

# --- Web server (keep 127.0.0.1: the SSM port-forward lands on localhost of the Master) ---
SR_HOST=127.0.0.1
SR_PORT=8090
SR_SESSION_HOURS=12
SR_MAX_UPLOAD_MB=300

# --- Paths ---
SR_REPO_ROOT=/opt/Scripts_Repo
SR_INSTANCE_DIR=/opt/Scripts_Repo/webapp/instance
SR_JMETER_HOME=/opt/apache-jmeter-5.6.3
# SR_JMETER_BIN=/opt/apache-jmeter-5.6.3/bin/jmeter

# --- Distributed mode: private IPs of the 2 slaves running jmeter-server ---
SR_REMOTE_HOSTS=10.0.1.11,10.0.1.12
SR_REMOTE_RMI_PORT=1099
SR_ALLOW_CONCURRENT_RUNS=0

# --- "Sync to slaves" button (rsync over SSH from the Master) ---
SR_SLAVE_SSH_USER=ec2-user
SR_SLAVE_SSH_KEY=/home/jmeter/.ssh/slaves_ed25519
SR_SLAVE_REPO_ROOT=/opt/Scripts_Repo

# --- Live monitor (InfluxDB 1.x written by the JMeter Backend Listener) ---
SR_INFLUX_URL=http://localhost:8086
# SR_INFLUX_USER=
# SR_INFLUX_PASSWORD=
SR_GRAFANA_URL=http://localhost:3000

# --- Confluence reports (each user stores their own URL + token under "Confluence") ---
# Restrict which hosts the Master may call with users' tokens (recommended):
SR_CONFLUENCE_ALLOWED_HOSTS=.atlassian.net
# Max total size of attachments per report (MB)
SR_CONFLUENCE_MAX_ATTACH_MB=80
# Grafana dashboard path for the "Dashboard de monitoreo" link ({app} = Backend Listener application)
# SR_GRAFANA_DASHBOARD_PATH=/d/<uid>/jmeter?var-application={app}
# Outbound proxy if the Master has no NAT Gateway:
# HTTPS_PROXY=http://proxy.internal:3128
