              <stringProp name="script">
// Initialize random number generator for a value between 1 and 50
int randomCount = new Random().nextInt(50) + 1;

List&lt;String&gt; elements = new ArrayList&lt;&gt;();

// Generate the elements (customizing the string as needed)
for (int i = 1; i &lt;= randomCount; i++) {
    // You can replace &quot;item_&quot; + i with random UUIDs, specific values, or test data
    elements.add(&quot;{\&quot;clientId\&quot;: null,\&quot;roleType\&quot;: null,\&quot;names\&quot;: \&quot;Zinhue\&quot;,\&quot;surnames\&quot;: \&quot;Gonzalez Montelongo\&quot;,\&quot;personType\&quot;: \&quot;FISICA\&quot;,\&quot;gender\&quot;: \&quot;Masculino\&quot;,\&quot;birthdate\&quot;: \&quot;2000-08-16\&quot;,\&quot;rfc\&quot;: \&quot;GOMZ910816L38\&quot;,\&quot;companyName\&quot;: \&quot;\&quot;,\&quot;nationality\&quot;: \&quot;Mexicana\&quot;}&quot;); 
}

// Concatenate the list using a comma
String concatenatedResult = String.join(&quot;,&quot;, elements);

// Store the result in a JMeter variable named &apos;randomCommaString&apos;
vars.put(&quot;P_Searches&quot;, concatenatedResult);

// Optional: Print to the JMeter console for debugging purposes
log.info(&quot;Generated &quot; + randomCount + &quot; elements: &quot; + concatenatedResult);
</stringProp>
