        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler ">
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">long now = System.currentTimeMillis();
String lastStr = vars.get(&quot;last_exec_time&quot;);
long last = (lastStr != null) ? lastStr.toLong() : 0;

if (now - last &gt;= 510000) {
    vars.put(&quot;last_exec_time&quot;, String.valueOf(now));
    vars.put(&quot;run_transaction&quot;, &quot;true&quot;);
} else {
    vars.put(&quot;run_transaction&quot;, &quot;false&quot;);
}

if (now - last &gt;= 1800000) {
    vars.put(&quot;last_exec_time&quot;, String.valueOf(now));
    vars.put(&quot;run_transaction_30mins&quot;, &quot;true&quot;);
} else {
    vars.put(&quot;run_transaction_30mins&quot;, &quot;false&quot;);
}

