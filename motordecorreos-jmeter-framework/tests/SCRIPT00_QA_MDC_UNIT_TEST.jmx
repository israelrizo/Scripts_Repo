        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import java.util.Random

// 1. Definir probabilidades para la distribución de pesos
Random rand = new Random()
int chance = rand.nextInt(100) // Genera un entero entre 0 y 99
int sizeInBytes = 0

if (chance &lt; 60) {
    // 60% probabilidad: Livianos (500 KB)
    sizeInBytes = 500 * 1024
} else if (chance &lt; 90) {
    // 30% probabilidad: Medianos (12.5 MB -&gt; cerca de la mitad del límite)
    sizeInBytes = 12.5 * 1024 * 1024 as int
} else {
    // 10% probabilidad: Pesados (23 MB)
    sizeInBytes = 23 * 1024 * 1024 as int
}

// 2. Generar un string del peso exacto deseado usando relleno de caracteres
// Genera un arreglo de bytes y lo llena con el carácter &apos;X&apos;
byte[] payloadBytes = new byte[sizeInBytes]
java.util.Arrays.fill(payloadBytes, (byte) &apos;X&apos;)
String dynamicPayload = new String(payloadBytes)

// 3. Almacenar la cadena en una variable de JMeter para usarla en el Body Data
vars.put(&quot;P_cuerpoPesado&quot;, dynamicPayload)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Response Assertion" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49588">202</stringProp>
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message"></stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">40</intProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="T01_POST_CORREO" enabled="false">
          <stringProp name="HTTPSampler.path">/fwk/utilities.svc</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&#xd;
&lt;soap:Envelope xmlns:soap=&quot;http://schemas.xmlsoap.org/soap/envelope/&quot;&gt;&#xd;
    &lt;soap:Body&gt;&#xd;
        &lt;SendCustomMail xmlns=&quot;BASE.CoreBusiness.DistributedServices.Utilities&quot;&gt;&#xd;
            &lt;dtoMail xmlns:d4p1=&quot;http://schemas.datacontract.org/2004/07/BASE.CoreBusiness.Domain.Entities.Correos.DTO&quot; xmlns:i=&quot;http://www.w3.org/2001/XMLSchema-instance&quot;&gt;&#xd;
                &lt;d4p1:Adjuntos i:nil=&quot;true&quot; /&gt;&#xd;
                &lt;d4p1:Destinatarios&gt;&#xd;
                    &lt;d4p1:MailToDTO&gt;&#xd;
                        &lt;d4p1:ToEmailAddress&gt;correo@ejemplo.com&lt;/d4p1:ToEmailAddress&gt;&#xd;
                        &lt;d4p1:ToEmailDisplayName&gt;Nombre Del Destinatario&lt;/d4p1:ToEmailDisplayName&gt;&#xd;
                    &lt;/d4p1:MailToDTO&gt;&#xd;
                &lt;/d4p1:Destinatarios&gt;&#xd;
                &lt;d4p1:IdCliente&gt;12&lt;/d4p1:IdCliente&gt;&#xd;
                &lt;d4p1:IdTipoCorreo&gt;1&lt;/d4p1:IdTipoCorreo&gt;&#xd;
                &lt;d4p1:ParametrosAsunto xmlns:d5p1=&quot;http://schemas.microsoft.com/2003/10/Serialization/Arrays&quot;&gt;&#xd;
                    &lt;d5p1:string&gt;Valor para el Asunto&lt;/d5p1:string&gt;&#xd;
                &lt;/d4p1:ParametrosAsunto&gt;&#xd;
                &lt;d4p1:ParametrosCuerpo xmlns:d5p1=&quot;http://schemas.microsoft.com/2003/10/Serialization/Arrays&quot;&gt;&#xd;
                    &lt;d5p1:string&gt;Primer valor para el cuerpo&lt;/d5p1:string&gt;&#xd;
                &lt;/d4p1:ParametrosCuerpo&gt;&#xd;
                &lt;d4p1:Programa&gt;NombreDeTuPrograma&lt;/d4p1:Programa&gt;&#xd;
            &lt;/dtoMail&gt;&#xd;
        &lt;/SendCustomMail&gt;&#xd;
    &lt;/soap:Body&gt;&#xd;
&lt;/soap:Envelope&gt;</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import java.util.Random

// 1. Definir probabilidades para la distribución de pesos
Random rand = new Random()
int chance = rand.nextInt(100) // Genera un entero entre 0 y 99
int sizeInBytes = 0

if (chance &lt; 60) {
    // 60% probabilidad: Livianos (500 KB)
    sizeInBytes = 500 * 1024
} else if (chance &lt; 90) {
    // 30% probabilidad: Medianos (12.5 MB -&gt; cerca de la mitad del límite)
    sizeInBytes = 12.5 * 1024 * 1024 as int
} else {
    // 10% probabilidad: Pesados (23 MB)
    sizeInBytes = 23 * 1024 * 1024 as int
}

// 2. Generar un string del peso exacto deseado usando relleno de caracteres
// Genera un arreglo de bytes y lo llena con el carácter &apos;X&apos;
byte[] payloadBytes = new byte[sizeInBytes]
java.util.Arrays.fill(payloadBytes, (byte) &apos;X&apos;)
String dynamicPayload = new String(payloadBytes)

// 3. Almacenar la cadena en una variable de JMeter para usarla en el Body Data
vars.put(&quot;P_cuerpoPesado&quot;, dynamicPayload)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
