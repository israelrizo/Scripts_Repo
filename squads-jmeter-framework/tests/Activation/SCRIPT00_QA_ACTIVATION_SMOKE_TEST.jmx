                <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

try {
    // 1. Ruta base del directorio de tus archivos
    String basePath = &quot;C:/Users/fcabello/Downloads/&quot;
    
    // 2. Mapeo con el prefijo P_ en el nombre de las variables
    def filesMap = [
        &quot;call_1000.json&quot;                 : &quot;P_call&quot;,
        &quot;alert_amount_received_1000.json&quot;  : &quot;P_amount&quot;,
        &quot;alert_price_queue_1000.json&quot;     : &quot;P_queue&quot;,
        &quot;alert_price_tracking_1000.json&quot;  : &quot;P_tracking&quot;
    ]

    int iteration = vars.getIteration() - 1

    // 3. Procesamiento dinámico de los 4 JSON
    filesMap.each { fileName, varName -&gt;
        File jsonFile = new File(basePath + fileName)

        if (jsonFile.exists()) {
            def dataset = new JsonSlurper().parse(jsonFile)
            int index = iteration % dataset.size()
            def currentItem = dataset[index]
            
            // Asignación de la variable con su prefijo P_
            vars.put(varName, JsonOutput.toJson(currentItem))
        } else {
            log.error(&quot;Archivo no encontrado: &quot; + fileName)
        }
    }

} catch (Exception e) {
    log.error(&quot;Error al procesar JSONs: &quot; + e.getMessage(), e)
}</stringProp>
