              <hashTree/>
              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="T04_GET_VALIDATION" enabled="true">
                <stringProp name="HTTPSampler.path">/advisor-tool/onboarding/process-manager/api/v1/processes/${P_documentId}</stringProp>
                <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
                <stringProp name="HTTPSampler.method">GET</stringProp>
                <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
                <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
                  <collectionProp name="Arguments.arguments"/>
                </elementProp>
              </HTTPSamplerProxy>
              <hashTree>
                <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="JSON Extractor" enabled="true">
                  <stringProp name="JSONPostProcessor.referenceNames">P_currentState;P_terminal</stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExprs">$.currentState;$.terminal</stringProp>
                  <stringProp name="JSONPostProcessor.match_numbers">1;1</stringProp>
                  <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND;false</stringProp>
                </JSONPostProcessor>
                <hashTree/>
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">def target = &apos;BOW_REVIEW&apos;
def deadStates = [&apos;REJECTED&apos;, &apos;FAILED&apos;, &apos;NEEDS_ATTENTION&apos;]
int maxTries = (vars.get(&apos;gateMaxTries&apos;) ?: &apos;30&apos;).toInteger()

String currentState = vars.get(&apos;P_currentState&apos;)
int tries = (vars.get(&apos;gateTries&apos;) ?: &apos;0&apos;).toInteger() + 1
vars.put(&apos;gateTries&apos;, tries.toString())

// 1. Caso Exitoso: alcanzó la compuerta de validación
if (currentState == target) {
    vars.put(&apos;gateTries&apos;, &apos;0&apos;)
    log.info(&quot;Compuerta 2 alcanzada exitosamente: &quot; + target)
} 
// 2. Caso Estado Muerto/Fallido
else if (deadStates.contains(currentState)) {
    vars.put(&apos;gateTries&apos;, &apos;0&apos;)
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;FALLO: La saga termino en estado &quot; + currentState + &quot; sin alcanzar &quot; + target)
} 
// 3. Caso Timeout: superó el número máximo de reintentos
else if (tries &gt;= maxTries) {
    //vars.put(&apos;gateTries&apos;, &apos;0&apos;)
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;TIMEOUT: Se alcanzaron &quot; + maxTries + &quot; reintentos en &quot; + target + &quot;. Estado actual: &quot; + currentState)
}</stringProp>
                </JSR223PostProcessor>
                <hashTree/>
              </hashTree>
            </hashTree>
            <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="SCRIPT01_QA_ONBOARDING_T05_DELETE_BINARY_TEARDOWN" enabled="true">
